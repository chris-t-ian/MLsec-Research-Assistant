{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(head .env)",
      "Bash(head * .env)",
      "Bash(tail .env)",
      "Bash(tail * .env)",
      "Bash(grep * .env)",
      "Bash(sed * .env)",
      "Bash(awk * .env)",
      "Bash(cp .env *)",
      "Bash(cp ./.env *)",
      "Bash(mv .env *)",
      "Bash(source .env)",
      "Bash(. .env)",
      "Bash(xxd .env)",
      "Bash(base64 .env)",
      "Bash(git add .env)",
      "Bash(git add -f .env)"
    ]
  }
}
